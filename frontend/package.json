{
  "name": "helios-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "ensure:deps": "if [ -x ./node_modules/.bin/vite ]; then echo \"Frontend dependencies present\"; else bun install --frozen-lockfile; fi",
    "codegen": "node ../tools/api-codegen/index.mjs",
    "predev": "bun run ensure:deps && bun run codegen && bun run prebuild:docs",
    "dev": "vite dev",
    "prebuild": "bun run ensure:deps && bun run prebuild:codegen && bun run prebuild:docs",
    "prebuild:codegen": "if [ \"$SKIP_CODEGEN\" = \"1\" ]; then echo \"Skipping codegen\"; else bun run codegen; fi",
    "prebuild:docs": "if [ \"$SKIP_DOCS_SYNC\" = \"1\" ]; then echo \"Skipping docs sync\"; else bun run docs:sync; fi",
    "docs:sync": "node ./scripts/sync-docs.mjs",
    "build": "bun run ensure:deps && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "precheck": "if [ \"$SKIP_CODEGEN\" = \"1\" ]; then echo \"Skipping codegen\"; else bun run codegen; fi",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --watch --tsconfig ./tsconfig.json",
    "prelint": "if [ \"$SKIP_CODEGEN\" = \"1\" ]; then echo \"Skipping codegen\"; else bun run codegen; fi",
    "lint": "eslint src --ext .ts,.svelte"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "1.50.1",
    "@skeletonlabs/skeleton": "^3.1.3",
    "@skeletonlabs/skeleton-svelte": "^1.2.3",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-static": "^3.0.5",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.178.0",
    "bun-types": "^1.3.2",
    "eslint": "^9.29.0",
    "eslint-plugin-svelte": "^3.9.2",
    "globals": "^16.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.2.6"
  },
  "dependencies": {
    "@asyncapi/react-component": "^2.6.3",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@noble/hashes": "^2.0.1",
    "@xyflow/svelte": "1.1.1",
    "d3": "^7.9.0",
    "fflate": "^0.8.2",
    "svelte-fa": "^4.0.4",
    "swagger-ui-dist": "^5.25.2",
    "three": "^0.178.0",
    "three-stdlib": "^2.36.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
