{
  "name": "helios-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11 <1.4.0",
    "node": ">=25.9.0 <26"
  },
  "scripts": {
    "ensure:deps": "if [ -x ./node_modules/.bin/vite ]; then echo \"Frontend dependencies present\"; else bun install --frozen-lockfile; fi",
    "codegen": "cargo run --manifest-path ../backend/Cargo.toml -p xtask -- generate generated-contracts",
    "predev": "bun run ensure:deps && bun run codegen && bun run prebuild:docs",
    "dev": "vite dev",
    "prebuild": "bun run ensure:deps && bun run prebuild:codegen && bun run prebuild:docs",
    "prebuild:codegen": "if [ \"$SKIP_CODEGEN\" = \"1\" ]; then echo \"Skipping codegen\"; else bun run codegen; fi",
    "prebuild:docs": "if [ \"$SKIP_DOCS_SYNC\" = \"1\" ]; then echo \"Skipping docs sync\"; else bun run docs:sync; fi",
    "docs:sync": "node ./scripts/sync-docs.mjs",
    "build": "bun run ensure:deps && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "precheck": "if [ \"$SKIP_CODEGEN\" = \"1\" ]; then echo \"Skipping codegen\"; else bun run codegen; fi",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:contracts": "cargo run --manifest-path ../backend/Cargo.toml -p xtask -- validate generated-contracts",
    "check:watch": "svelte-check --watch --tsconfig ./tsconfig.json",
    "prelint": "if [ \"$SKIP_CODEGEN\" = \"1\" ]; then echo \"Skipping codegen\"; else bun run codegen; fi",
    "lint": "eslint src --ext .ts,.svelte"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.59.1",
    "@skeletonlabs/skeleton": "^4.14.0",
    "@skeletonlabs/skeleton-svelte": "^4.14.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.183.1",
    "bun-types": "^1.3.11",
    "eslint": "^10.1.0",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "svelte": "^5.55.1",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3"
  },
  "dependencies": {
    "@asyncapi/react-component": "^3.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@noble/hashes": "^2.0.1",
    "@xyflow/svelte": "1.5.1",
    "d3": "^7.9.0",
    "fflate": "^0.8.2",
    "svelte-fa": "^4.0.4",
    "swagger-ui-dist": "^5.32.1",
    "three": "^0.183.2",
    "three-stdlib": "^2.36.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
