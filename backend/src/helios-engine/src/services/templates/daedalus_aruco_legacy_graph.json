  "metadata": {
    "helios.pipeline.alias": "ArUco (Daedalus)",
    "helios.daedalus.gpu_backend": "cpu",
    "helios.daedalus.planner.enable_gpu": "false",
    "helios.pipeline.ui": {
      "title": "ArUco Tags",
      "description": "Curated tuning controls for the single-polarity ArUco tag pipeline.",
      "layout": {
        "type": "tabs",
        "tabs": [
          {
            "id": "preprocess",
            "title": "Preprocess",
            "content": [
              {
                "type": "text",
                "id": "preprocess_intro",
                "text": "Prepare the incoming frame before contour detection."
              },
              {
                "type": "slider",
                "id": "preprocess_downscale_factor",
                "label": "Downscale factor",
                "bind": "1.factor",
                "min": 1,
                "max": 8,
                "step": 1
              },
              {
                "type": "slider",
                "id": "preprocess_blur_sigma",
                "label": "Blur sigma",
                "bind": "2.sigma",
                "min": 0,
                "max": 10,
                "step": 0.1
              },
              {
                "type": "slider",
                "id": "preprocess_threshold_window",
                "label": "Threshold window",
                "bind": "3.window",
                "min": 3,
                "max": 99,
                "step": 2
              },
              {
                "type": "slider",
                "id": "preprocess_threshold_offset",
                "label": "Threshold offset",
                "bind": "3.offset",
                "min": -20,
                "max": 20,
                "step": 1
              },
              {
                "type": "slider",
                "id": "preprocess_threshold_bias",
                "label": "Threshold bias",
                "bind": "3.threshold_offset",
                "min": -50,
                "max": 50,
                "step": 1
              },
              {
                "type": "accordion",
                "id": "preprocess_advanced",
                "title": "Advanced",
                "items": [
                  {
                    "type": "select",
                    "id": "preprocess_blur_mode",
                    "label": "Blur mode",
                    "bind": "2.mode"
                  },
                  {
                    "type": "select",
                    "id": "preprocess_threshold_mode",
                    "label": "Threshold mode",
                    "bind": "3.mode"
                  }
                ]
              }
            ]
          },
          {
            "id": "candidates",
            "title": "Candidates",
            "content": [
              {
                "type": "text",
                "id": "candidates_intro",
                "text": "Control quad extraction before tag decoding."
              },
              {
                "type": "slider",
                "id": "candidates_epsilon",
                "label": "Polygon epsilon",
                "bind": "6.epsilon",
                "min": 0,
                "max": 1,
                "step": 0.01
              },
              {
                "type": "slider",
                "id": "candidates_min_area",
                "label": "Min area",
                "bind": "6.min_area",
                "min": 0,
                "max": 100000,
                "step": 10
              },
              {
                "type": "slider",
                "id": "candidates_max_area",
                "label": "Max area",
                "bind": "6.max_area",
                "min": 0,
                "max": 200000,
                "step": 10
              },
              {
                "type": "toggle",
                "id": "candidates_refine_corners",
                "label": "Refine corners",
                "bind": "6.refine_corners"
              },
              {
                "type": "accordion",
                "id": "candidates_advanced",
                "title": "Advanced",
                "items": [
                  {
                    "type": "slider",
                    "id": "candidates_downscale",
                    "label": "Candidate downscale",
                    "bind": "6.downscale",
                    "min": 1,
                    "max": 4,
                    "step": 1
                  },
                  {
                    "type": "slider",
                    "id": "candidates_min_angle",
                    "label": "Min angle (deg)",
                    "bind": "6.min_angle_deg",
                    "min": 0,
                    "max": 90,
                    "step": 1
                  },
                  {
                    "type": "slider",
                    "id": "candidates_max_angle",
                    "label": "Max angle (deg)",
                    "bind": "6.max_angle_deg",
                    "min": 90,
                    "max": 180,
                    "step": 1
                  },
                  {
                    "type": "slider",
                    "id": "candidates_max_side_cv",
                    "label": "Max side CV",
                    "bind": "6.max_side_cv",
                    "min": 0,
                    "max": 1,
                    "step": 0.01
                  },
                  {
                    "type": "slider",
                    "id": "candidates_max_side_ratio",
                    "label": "Max side ratio",
                    "bind": "6.max_side_ratio",
                    "min": 0,
                    "max": 10,
                    "step": 0.1
                  },
                  {
                    "type": "slider",
                    "id": "candidates_max_diag_ratio",
                    "label": "Max diag ratio",
                    "bind": "6.max_diag_ratio",
                    "min": 0,
                    "max": 10,
                    "step": 0.1
                  },
                  {
                    "type": "slider",
                    "id": "candidates_refine_edge_dist",
                    "label": "Refine edge dist",
                    "bind": "6.refine_edge_dist",
                    "min": 0,
                    "max": 10,
                    "step": 0.1
                  },
                  {
                    "type": "slider",
                    "id": "candidates_refine_min_points",
                    "label": "Refine min points",
                    "bind": "6.refine_min_points",
                    "min": 0,
                    "max": 20,
                    "step": 1
                  },
                  {
                    "type": "slider",
                    "id": "candidates_min_perimeter_rate",
                    "label": "Min perimeter rate",
                    "bind": "6.min_perimeter_rate",
                    "min": 0,
                    "max": 1,
                    "step": 0.01
                  },
                  {
                    "type": "slider",
                    "id": "candidates_max_perimeter_rate",
                    "label": "Max perimeter rate",
                    "bind": "6.max_perimeter_rate",
                    "min": 0,
                    "max": 4,
                    "step": 0.01
                  },
                  {
                    "type": "slider",
                    "id": "candidates_min_corner_distance_rate",
                    "label": "Min corner distance rate",
                    "bind": "6.min_corner_distance_rate",
                    "min": 0,
                    "max": 1,
                    "step": 0.01
                  },
                  {
                    "type": "slider",
                    "id": "candidates_min_distance_border",
                    "label": "Min distance to border",
                    "bind": "6.min_distance_to_border_px",
                    "min": 0,
                    "max": 100,
                    "step": 1
                  },
                  {
                    "type": "slider",
                    "id": "candidates_min_marker_distance",
                    "label": "Min marker distance rate",
                    "bind": "6.min_marker_distance_rate",
                    "min": 0,
                    "max": 1,
                    "step": 0.01
                  },
                  {
                    "type": "select",
                    "id": "candidates_mode",
                    "label": "Candidate mode",
                    "bind": "6.mode"
                  }
                ]
              }
            ]
          },
          {
            "id": "decode",
            "title": "Decode",
            "content": [
              {
                "type": "text",
                "id": "decode_intro",
                "text": "Tune tag decoding thresholds and dictionary selection."
              },
              {
                "type": "select",
                "id": "decode_dictionary",
                "label": "Dictionary",
                "bind": "7.dictionary"
              },
              {
                "type": "slider",
                "id": "decode_max_hamming",
                "label": "Max hamming",
                "bind": "7.max_hamming",
                "min": 0,
                "max": 10,
                "step": 1
              },
              {
                "type": "slider",
                "id": "decode_sample_scale",
                "label": "Sample scale",
                "bind": "7.sample_scale",
                "min": 0.2,
                "max": 2,
                "step": 0.05
              },
              {
                "type": "slider",
                "id": "decode_border_error_divisor",
                "label": "Border error divisor",
                "bind": "7.border_error_divisor",
                "min": 1,
                "max": 10,
                "step": 1
              },
              {
                "type": "accordion",
                "id": "decode_advanced",
                "title": "Advanced",
                "items": [
                  {
                    "type": "toggle",
                    "id": "decode_refine_warp",
                    "label": "Refine corners warp",
                    "bind": "7.refine_corners_warp"
                  },
                  {
                    "type": "slider",
                    "id": "decode_refine_warp_scale",
                    "label": "Refine warp scale",
                    "bind": "7.refine_corners_warp_scale",
                    "min": 0,
                    "max": 8,
                    "step": 1
                  },
                  {
                    "type": "slider",
                    "id": "decode_cell_sample_grid",
                    "label": "Cell sample grid",
                    "bind": "7.cell_sample_grid",
                    "min": 2,
                    "max": 10,
                    "step": 1
                  },
                  {
                    "type": "slider",
                    "id": "decode_cell_sample_margin",
                    "label": "Cell sample margin",
                    "bind": "7.cell_sample_margin",
                    "min": 0,
                    "max": 1,
                    "step": 0.01
                  },
                  {
                    "type": "slider",
                    "id": "decode_patch_contrast",
                    "label": "Warped patch contrast",
                    "bind": "7.min_warped_patch_contrast_range",
                    "min": 0,
                    "max": 1,
                    "step": 0.01
                  },
                  {
                    "type": "toggle",
                    "id": "decode_warp_fallback_fail",
                    "label": "Fallback on decode fail",
                    "bind": "7.warp_fallback_on_decode_fail"
                  },
                  {
                    "type": "toggle",
                    "id": "decode_warp_fallback_contrast",
                    "label": "Fallback on low contrast",
                    "bind": "7.warp_fallback_on_low_contrast"
                  },
                  {
                    "type": "slider",
                    "id": "decode_cell_means_contrast",
                    "label": "Cell means contrast",
                    "bind": "7.min_cell_means_contrast_range",
                    "min": 0,
                    "max": 1,
                    "step": 0.01
                  },
                  {
                    "type": "slider",
                    "id": "decode_hamming_margin",
                    "label": "Min hamming margin",
                    "bind": "7.min_hamming_margin",
                    "min": 0,
                    "max": 1,
