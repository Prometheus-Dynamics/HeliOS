#Generated .env file with default configuration values

LOG_FOLDER = ./Helios-Backend/log

LOGGING_MODE = DEV

LOG_LEVEL = INFO

MAX_LOG_ARCHIVES = 10
MAX_PANIC_LOGS = 10

DATA_FOLDER = ./Helios-Backend/data

MAX_THREADS = 4

DEVICE_NAME = helios

HTTP_BIND_ADDRESS = 0.0.0.0

HTTP_BIND_PORT = 5800

API_THREADS = 1

PREFERRED_CAPTURE_BACKEND = LibcameraCaptureBackend

PREFERRED_CAPTURE_RESOLUTION_WIDTH = 1920

PREFERRED_CAPTURE_RESOLUTION_HEIGHT = 1080

PREFERRED_CAPTURE_FORMAT = MJPG

PREFERRED_CAPTURE_FPS = 60

PREFERRED_DECODER_BACKEND = ZuneDecoderBackend

PREFERRED_DECODER_FPS = 60

PREFERRED_DECODER_THREADS = 4

PREFERRED_ENCODER_BACKEND = FFmpegMJPEGEncoderBackend

PREFERRED_ENCODER_FPS = 60

PREFERRED_ENCODER_THREADS = 4

ENCODER_OUTPUT_FORMAT = MJPG

ENCODER_OUTPUT_WIDTH = 1920
ENCODER_OUTPUT_HEIGHT = 1080

OPTIONAL_KERNEL_MODULES=
IMU_ANGLE_RANGE=0-360
IMU_UPDATE_INTERVAL_MS=5
