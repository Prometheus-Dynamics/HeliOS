# orion-node on SystemCore (variables in Orion docs/node-env.md). The single-node appliance
# profile, as on Raze, with HeliOS's state under the guest layout.
ORION_NODE_ID=node-local
# orion-node runs as root here (SystemCore has no orion user, and a guest adds no host users).
ORION_NODE_LOCAL_AUTH=same-user-or-group-or-root
ORION_NODE_STATE_DIR=/usr/local/var/lib/helios/orion
ORION_NODE_IPC_SOCKET=/run/orion/control.sock
ORION_NODE_IPC_STREAM_SOCKET=/run/orion/control-stream.sock
ORION_NODE_HOST_FACTS_REFRESH_MS=2000
ORION_NODE_HTTP_ADDR=off
ORION_NODE_RUNTIME_WORKER_THREADS=2
ORION_NODE_RUNTIME_MAX_BLOCKING_THREADS=4
ORION_NODE_MAX_MUTATION_HISTORY=64
ORION_NODE_MAX_MUTATION_HISTORY_BYTES=262144
ORION_NODE_LOCAL_CLIENT_EVENT_QUEUE_LIMIT=128
ORION_NODE_OBSERVABILITY_EVENT_LIMIT=64
ORION_NODE_PERSISTENCE_WORKER_QUEUE_CAPACITY=32
ORION_NODE_AUDIT_LOG_QUEUE_CAPACITY=256
ORION_NODE_OBSERVED_PERSIST_INTERVAL_MS=5000
MALLOC_ARENA_MAX=2
