# The HeliOS API and UI on SystemCore, on port 5880 (Limelight's services use 5800-5837).
[Unit]
Description=HeliOS API
After=network.target helios-orion.service
Wants=network.target helios-orion.service
StartLimitIntervalSec=0

[Service]
Type=simple
Slice=vision.slice
# Two tokio workers and two glibc arenas: -0.6 MB (engine) / -0.45 MB (api) PSS on the CM5,
# no measured cost (the frame path runs on its own threads). Overridable in the env file.
Environment=TOKIO_WORKER_THREADS=2 MALLOC_ARENA_MAX=2
EnvironmentFile=/usr/local/etc/helios/helios.env
Environment=HELIOS_API_BIND=0.0.0.0:5880
EnvironmentFile=-/usr/local/etc/helios/local.env
EnvironmentFile=-/run/helios/robot.env
ExecStart=/usr/local/bin/helios-api
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1
RestartSteps=4
RestartMaxDelaySec=8
TimeoutStopSec=10
ExecStartPre=/bin/mkdir -p /usr/local/var/lib/helios /usr/local/var/log/helios
WorkingDirectory=-/usr/local/var/lib/helios
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
