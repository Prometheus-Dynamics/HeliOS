      "helios.pipeline.alias": "HSV Color Detection (Daedalus)",
      "helios.pipeline.ui": {
        "title": "HSV Color Detection",
        "description": "Curated controls for HSV masking and contour filtering.",
        "layout": {
          "type": "tabs",
          "tabs": [
            {
              "id": "preprocess",
              "title": "Preprocess",
              "content": [
                {
                  "type": "text",
                  "id": "preprocess_intro",
                  "text": "Prepare the frame before masking."
                },
                {
                  "type": "slider",
                  "id": "preprocess_downscale_factor",
                  "label": "Downscale factor",
                  "bind": "1.factor",
                  "min": 1,
                  "max": 8,
                  "step": 1
                },
                {
                  "type": "slider",
                  "id": "preprocess_blur_sigma",
                  "label": "Blur sigma",
                  "bind": "2.sigma",
                  "min": 0,
                  "max": 10,
                  "step": 0.1
                },
                {
                  "type": "accordion",
                  "id": "preprocess_advanced",
                  "title": "Advanced",
                  "items": [
                    {
                      "type": "select",
                      "id": "preprocess_blur_mode",
                      "label": "Blur mode",
                      "bind": "2.mode"
                    }
                  ]
                }
              ]
            },
            {
              "id": "mask",
              "title": "Mask",
              "content": [
                {
                  "type": "text",
                  "id": "mask_intro",
                  "text": "Define the HSV range used to build the mask."
                },
                {
                  "type": "hsv_range",
                  "id": "mask_hsv_range",
                  "label": "HSV Range",
                  "hsvRangeMode": "include",
                  "hsvRangeDefaults": {
                    "h": [
                      50,
                      160
                    ],
                    "s": [
                      0.25,
                      1
                    ],
                    "v": [
                      0.2,
                      1
                    ]
                  }
                },
                {
                  "type": "accordion",
                  "id": "mask_advanced",
                  "title": "Advanced",
                  "items": [
                    {
                      "type": "select",
                      "id": "mask_mode",
                      "label": "Mask mode",
                      "bind": "3.mode"
                    },
                    {
                      "type": "select",
                      "id": "apply_mask_mode",
                      "label": "Apply mask mode",
                      "bind": "4.mode"
                    }
                  ]
                }
              ]
            },
            {
              "id": "contours",
              "title": "Contours",
              "content": [
                {
                  "type": "text",
                  "id": "contours_intro",
                  "text": "Filter contours and reduce noise."
                },
                {
                  "type": "slider",
                  "id": "contours_epsilon",
                  "label": "Simplify epsilon",
                  "bind": "6.epsilon",
                  "min": 0,
                  "max": 20,
                  "step": 0.1
                },
                {
                  "type": "slider",
                  "id": "contours_min_area",
                  "label": "Min area",
                  "bind": "7.min_area",
                  "min": 0,
                  "max": 200000,
                  "step": 10
                },
                {
                  "type": "slider",
                  "id": "contours_max_area",
                  "label": "Max area",
                  "bind": "7.max_area",
                  "min": 0,
                  "max": 200000,
                  "step": 10
                },
                {
                  "type": "slider",
                  "id": "contours_min_width",
                  "label": "Min width",
                  "bind": "7.min_width",
                  "min": 0,
                  "max": 1000,
                  "step": 1
                },
                {
                  "type": "slider",
                  "id": "contours_min_height",
                  "label": "Min height",
                  "bind": "7.min_height",
                  "min": 0,
                  "max": 1000,
                  "step": 1
                },
                {
                  "type": "accordion",
                  "id": "contours_advanced",
                  "title": "Advanced",
                  "items": [
                    {
                      "type": "slider",
                      "id": "contours_max_items",
                      "label": "Max JSON items",
                      "bind": "8.max_items",
                      "min": 1,
                      "max": 500,
                      "step": 1
                    }
                  ]
                }
              ]
            }
          ]
