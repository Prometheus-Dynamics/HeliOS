[Unit]
Description=Helios Engine Service
After=network.target local-fs.target var-lib-helios.mount
RequiresMountsFor=/var/lib/helios
Wants=helios-engine.socket
Requires=helios-engine.socket
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# helios-engine does not emit sd_notify; treat it as a simple service to avoid start timeouts.
Type=simple
NotifyAccess=none
ExecStartPre=/bin/sh -lc 'i=0; while [ $i -lt 60 ]; do awk '\''$5==\"/var/lib/helios\"{found=1} END{exit !found}'\'' /proc/self/mountinfo && exit 0; i=$((i+1)); sleep 1; done; echo \"DATA mount missing: /var/lib/helios is not a mountpoint\" >&2; exit 1'
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios/panics
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios/engine
ExecStartPre=/usr/bin/install -d -m0755 /usr/lib/helios/plugins/daedalus
ExecStartPre=/usr/bin/install -d -m0755 /var/lib/helios/plugins/daedalus
ExecStartPre=/bin/sh -lc 'echo 1 > /proc/sys/kernel/core_uses_pid; echo /var/log/helios/core-%%e-%%p > /proc/sys/kernel/core_pattern; ulimit -c unlimited'
Environment=ENGINE_SOCKET=/run/helios/engine.sock
Environment=ENGINE_JOURNAL_PATH=/var/lib/helios/journal/engine.log
Environment=LOG_FOLDER=/var/log/helios
Environment=ENGINE_METRICS_ADDR=0.0.0.0:5804
Environment=LD_LIBRARY_PATH=/usr/lib/edgetpu:/usr/lib
# Keep stall recovery enabled, but avoid overly aggressive 1s restart churn under
# heavy graph load; repeated restart loops correlate with large RSS growth.
Environment=HELIOS_CAPTURE_STALL_MS=6000
Environment=HELIOS_CAPTURE_ACTIVE_STALL_MS=5000
Environment=HELIOS_DAEDALUS_PLUGIN_DIRS=/var/lib/helios/plugins/daedalus:/usr/lib/helios/plugins/daedalus
Environment=HELIOS_API_DATA_DIR=/var/lib/helios/api-data
EnvironmentFile=-/etc/default/helios-engine
ExecStart=/usr/bin/helios-engine
Restart=always
RestartSec=2
TimeoutStopSec=45
User=root
Group=root
WorkingDirectory=/var/lib/helios
StateDirectory=helios helios/journal helios/state
LogsDirectory=helios
LimitNOFILE=65536
LimitCORE=0
TasksMax=infinity
OOMScoreAdjust=-500
IOSchedulingClass=realtime
IOSchedulingPriority=1
CPUAffinity=1 2 3
Nice=-5

[Install]
WantedBy=multi-user.target
Also=helios-engine.socket
