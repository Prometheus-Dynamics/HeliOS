
[Unit]
Description=Mount DATA partition at /var/lib/helios
Documentation=man:systemd.mount(5)
DefaultDependencies=yes
After=systemd-remount-fs.service helios-provision.service
[Mount]
What=LABEL=DATA
Where=/var/lib/helios
Type=ext4
Options=rw,nosuid,noatime,nofail,x-systemd.device-timeout=10s,x-systemd.growfs,x-systemd.makefs
TimeoutSec=12s

[Install]
WantedBy=local-fs.target
