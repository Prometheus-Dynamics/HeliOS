# HeliOS override for pd-device-hostname.service (defaults in
# /usr/lib/pd-device/hostname.env). The image sets no static hostname
# (/etc/hostname is absent on the read-only root), so the device package
# applies this pattern as the transient hostname: helios-<last 8 hex digits of
# the board serial>, e.g. helios-abcdef01.local. A user override goes in
# /data/pd-device/hostname.env.
PD_HOSTNAME_PATTERN=helios-{serial8}
