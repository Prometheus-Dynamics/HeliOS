# HeliOS override for pd-device-ssh-keys.service (defaults in
# /usr/lib/pd-device/ssh-keys.env). The root filesystem is an overlay over the
# squashfs slot, so the device package cannot derive the boot partition from
# the root mount; on the Raze it is the first eMMC partition.
SSH_KEYS_BOOT_PARTITION=/dev/mmcblk0p1
