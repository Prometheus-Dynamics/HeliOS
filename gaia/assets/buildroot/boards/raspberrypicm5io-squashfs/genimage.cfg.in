image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}
	}

	size = 18M
}

image sdcard.img {
	hdimage {
		disk-signature = 0x48454c49
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.squashfs"
	}
}
