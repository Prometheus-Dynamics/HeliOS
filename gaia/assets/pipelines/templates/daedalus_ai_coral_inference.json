    "metadata": {
      "helios.pipeline.alias": "Coral AI Inference (Daedalus)",
      "helios.pipeline.ui": {
        "title": "Coral AI Inference",
        "description": "Tune model selection and inference thresholds.",
        "layout": {
          "type": "tabs",
          "tabs": [
            {
              "id": "model",
              "title": "Model",
              "content": [
                {
                  "type": "text",
                  "id": "model_intro",
                  "text": "Select the model and runtime device used for inference."
                },
                {
                  "type": "select",
                  "id": "model_id",
                  "label": "Model ID",
                  "bind": "2.model_id"
                },
                {
                  "type": "select",
                  "id": "device_path",
                  "label": "Device",
                  "bind": "2.device_path"
                },
                {
                  "type": "accordion",
                  "id": "model_advanced",
                  "title": "Advanced",
                  "items": [
                    {
                      "type": "select",
                      "id": "preprocess_model_id",
                      "label": "Preprocess model ID",
                      "bind": "1.model_id",
                      "help": "Keep this aligned with the encode model."
                    }
                  ]
                }
              ]
            },
            {
              "id": "inference",
              "title": "Inference",
              "content": [
                {
                  "type": "slider",
                  "id": "min_score",
                  "label": "Minimum score",
                  "bind": "2.min_score",
                  "min": 0,
                  "max": 1,
                  "step": 0.01,
                  "trackGradient": "linear-gradient(90deg, #334155, #38bdf8)"
                },
                {
                  "type": "slider",
                  "id": "max_results",
                  "label": "Max results",
                  "bind": "2.max_results",
                  "min": 1,
                  "max": 100,
                  "step": 1
                },
                {
                  "type": "accordion",
                  "id": "inference_advanced",
                  "title": "Advanced",
                  "items": [
                    {
                      "type": "toggle",
                      "id": "normalize",
                      "label": "Normalize input",
                      "bind": "2.normalize",
                      "help": "Enable if the model expects normalized inputs."
                    }
                  ]
                }
              ]
            },
            {
              "id": "overlay",
              "title": "Overlay",
              "content": [
                {
                  "type": "toggle",
                  "id": "overlay_enabled",
                  "label": "Enable overlay",
                  "bind": "5.enabled"
                },
                {
                  "type": "toggle",
                  "id": "show_label",
                  "label": "Show label text",
                  "bind": "5.show_label"
                },
                {
                  "type": "toggle",
                  "id": "show_score",
                  "label": "Show confidence",
                  "bind": "5.show_score"
                },
                {
                  "type": "toggle",
                  "id": "show_class_id",
                  "label": "Show class id",
                  "bind": "5.show_class_id"
                },
                {
                  "type": "toggle",
                  "id": "show_crosshair",
                  "label": "Show crosshair",
                  "bind": "5.show_crosshair"
                },
                {
                  "type": "slider",
                  "id": "overlay_thickness",
                  "label": "Box thickness",
                  "bind": "5.thickness",
                  "min": 1,
                  "max": 16,
                  "step": 1
                },
                {
                  "type": "slider",
                  "id": "label_scale",
                  "label": "Label scale",
                  "bind": "5.label_scale",
                  "min": 0.2,
                  "max": 3.0,
                  "step": 0.1
                },
                {
                  "type": "slider",
                  "id": "crosshair_scale",
                  "label": "Crosshair scale",
                  "bind": "5.crosshair_scale",
                  "min": 0.05,
                  "max": 1.0,
                  "step": 0.05
                }
              ]
            }
          ]
        }
      }
