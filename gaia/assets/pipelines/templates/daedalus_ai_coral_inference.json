{
  "id": "daedalus_ai_coral_inference",
  "name": "Coral AI Inference",
  "summary": "Run an Edge TPU-compiled model on the Coral TPU and emit detections.",
  "tags": [
    "ai",
    "coral",
    "inference",
    "tpu"
  ],
  "graph": {
    "nodes": [
      {
        "id": "io.host_bridge",
        "label": "Input:frame",
        "inputs": [],
        "outputs": [
          "frame",
          "crosshair_x",
          "crosshair_y"
        ],
        "metadata": {
          "host_bridge": {
            "type": "Bool",
            "value": true
          },
          "host_bridge_outputs": {
            "type": "String",
            "value": "frame:image:dynamic,crosshair_x:int,crosshair_y:int"
          },
          "helios.host_input_port": {
            "type": "String",
            "value": "frame"
          }
        }
      },
      {
        "id": "ai:preprocess",
        "label": "AI Preprocess",
        "inputs": [
          "frame",
          "model_id",
          "resize"
        ],
        "outputs": [
          "frame"
        ],
        "const_inputs": [
          [
            "model_id",
            {
              "type": "String",
              "value": ""
            }
          ],
          [
            "resize",
            {
              "type": "Bool",
              "value": false
            }
          ]
        ]
      },
      {
        "id": "ai:encode",
        "label": "AI Encode",
        "inputs": [
          "frame",
          "model_id",
          "device_path",
          "min_score",
          "max_results",
          "normalize"
        ],
        "outputs": [
          "tensor",
          "config"
        ],
        "const_inputs": [
          [
            "model_id",
            {
              "type": "String",
              "value": ""
            }
          ],
          [
            "device_path",
            {
              "type": "String",
              "value": "Auto|auto"
            }
          ],
          [
            "min_score",
            {
              "type": "Float",
              "value": 0.5
            }
          ],
          [
            "max_results",
            {
              "type": "Int",
              "value": 25
            }
          ],
          [
            "normalize",
            {
              "type": "Bool",
              "value": true
            }
          ]
        ]
      },
      {
        "id": "ai:run",
        "label": "AI Run",
        "inputs": [
          "tensor",
          "config"
        ],
        "outputs": [
          "results",
          "config"
        ]
      },
      {
        "id": "ai:detections",
        "label": "AI Detections",
        "inputs": [
          "results",
          "config"
        ],
        "outputs": [
          "detections"
        ]
      },
      {
        "id": "ai:overlay_detections",
        "label": "AI Overlay",
        "inputs": [
          "frame",
          "detections",
          "enabled",
          "show_label",
          "show_score",
          "show_class_id",
          "show_crosshair",
          "thickness",
          "label_scale",
          "crosshair_scale"
        ],
        "outputs": [
          "frame"
        ],
        "const_inputs": [
          [
            "enabled",
            {
              "type": "Bool",
              "value": true
            }
          ],
          [
            "show_label",
            {
              "type": "Bool",
              "value": true
            }
          ],
          [
            "show_score",
            {
              "type": "Bool",
              "value": true
            }
          ],
          [
            "show_class_id",
            {
              "type": "Bool",
              "value": true
            }
          ],
          [
            "show_crosshair",
            {
              "type": "Bool",
              "value": false
            }
          ],
          [
            "thickness",
            {
              "type": "Int",
              "value": 2
            }
          ],
          [
            "label_scale",
            {
              "type": "Float",
              "value": 1.0
            }
          ],
          [
            "crosshair_scale",
            {
              "type": "Float",
              "value": 0.25
            }
          ]
        ]
      },
      {
        "id": "io.host_output",
        "label": "Output:ai",
        "inputs": [
          "frame",
          "detections",
          "target_detections",
          "tv",
          "tid",
          "tx",
          "ty",
          "ta",
          "distance_px",
          "target_cx",
          "target_cy",
          "thor",
          "tvert",
          "tshort",
          "tlong"
        ],
        "outputs": [],
        "metadata": {
          "host_bridge": {
            "type": "Bool",
            "value": true
          }
        }
      },
      {
        "id": "ai:detections_crosshair_target",
        "label": "Crosshair Target",
        "inputs": [
          "detections",
          "crosshair_x",
          "crosshair_y"
        ],
        "outputs": [
          "detections",
          "tv",
          "tid",
          "tx",
          "ty",
          "ta",
          "distance_px",
          "cx",
          "cy",
          "thor",
          "tvert",
          "tshort",
          "tlong"
        ],
        "const_inputs": []
