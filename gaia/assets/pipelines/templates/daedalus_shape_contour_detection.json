                  "type": "accordion",
                  "id": "mask_advanced",
                  "title": "Advanced",
                  "items": [
                    {
                      "type": "input",
                      "id": "mask_threshold_exact",
                      "label": "Threshold (exact)",
                      "bind": "3.threshold"
                    }
                  ]
                }
              ]
            },
            {
              "id": "contours",
              "title": "Contours",
              "content": [
