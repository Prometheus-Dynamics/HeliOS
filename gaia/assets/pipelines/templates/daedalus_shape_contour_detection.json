        "layout": {
          "type": "tabs",
          "tabs": [
            {
              "id": "preprocess",
              "title": "Preprocess",
              "content": [
                {
                  "type": "text",
                  "id": "preprocess_intro",
                  "text": "Prepare the frame before thresholding."
                },
                {
                  "type": "slider",
                  "id": "preprocess_downscale_factor",
                  "label": "Downscale factor",
                  "bind": "1.factor",
                  "min": 1,
                  "max": 8,
                  "step": 1
                },
                {
                  "type": "slider",
                  "id": "preprocess_blur_sigma",
                  "label": "Blur sigma",
                  "bind": "2.sigma",
                  "min": 0,
                  "max": 10,
                  "step": 0.1
                },
                {
                  "type": "accordion",
                  "id": "preprocess_advanced",
