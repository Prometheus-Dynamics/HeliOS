                  "type": "text",
                  "id": "mask_intro",
                  "text": "Define the binary threshold used to build the mask."
                },
                {
                  "type": "slider",
                  "id": "mask_threshold",
                  "label": "Threshold",
                  "bind": "3.threshold",
                  "min": 0,
                  "max": 255,
                  "step": 1
                },
