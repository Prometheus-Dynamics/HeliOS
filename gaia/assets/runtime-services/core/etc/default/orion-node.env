# /etc/default/orion-node.env on HeliOS: settings for Orion's orion-node.service
# (unit and defaults from Orion's packaging/, variables in Orion docs/node-env.md).
# It replaces Orion's example file. Plain KEY=value lines; assignments here
# override the unit's Environment= defaults.

# --- Identity ------------------------------------------------------------------
# The HeliOS services default to this node id (helios-engine, helios-peripherals).
ORION_NODE_ID=node-local

# --- Local IPC -----------------------------------------------------------------
# The node runs as orion. It admits callers in the orion group (helios-engine
# and helios-peripherals run with Group=orion) and root: helios-api runs as
# root, and operators run orionctl from a root shell ("Local IPC access" in
# Orion docs/node-env.md).
ORION_NODE_LOCAL_AUTH=same-user-or-group-or-root

# --- State ---------------------------------------------------------------------
# On the DATA partition, shared by both root slots, so desired state survives an
# A/B update. The drop-in orion-node.service.d/10-helios-state.conf makes this
# directory the unit's StateDirectory.
ORION_NODE_STATE_DIR=/var/lib/helios/orion

# --- Image identity ------------------------------------------------------------
# Host facts take IMAGE_ID/IMAGE_VERSION from the build's version file rather
# than the static os-release.
ORION_NODE_IMAGE_VERSION_FILE=/etc/default/helios-image.env

# --- Host metrics --------------------------------------------------------------
# One host-facts sample (CPU per core, temperatures, memory, load) every 2 s:
# helios-api follows the node's host.* status keys for the UI's live metrics
# instead of reading /proc and /sys itself (Orion docs/host-facts.md).
ORION_NODE_HOST_FACTS_REFRESH_MS=2000

# --- Single-node appliance profile ---------------------------------------------
# IPC only: no HTTP control plane, no peers, no discovery.
ORION_NODE_HTTP_ADDR=off
ORION_NODE_RUNTIME_WORKER_THREADS=2
ORION_NODE_RUNTIME_MAX_BLOCKING_THREADS=4
ORION_NODE_MAX_MUTATION_HISTORY=64
ORION_NODE_MAX_MUTATION_HISTORY_BYTES=262144
ORION_NODE_LOCAL_CLIENT_EVENT_QUEUE_LIMIT=128
ORION_NODE_OBSERVABILITY_EVENT_LIMIT=64
ORION_NODE_PERSISTENCE_WORKER_QUEUE_CAPACITY=32
ORION_NODE_AUDIT_LOG_QUEUE_CAPACITY=256
# Coalesce observed/applied state writes (eMMC wear): at most one per interval.
ORION_NODE_OBSERVED_PERSIST_INTERVAL_MS=5000
