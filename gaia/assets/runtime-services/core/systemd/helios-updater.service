[Unit]
Description=Helios Updater Service
After=network.target systemd-remount-fs.service local-fs.target
Wants=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios/panics
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios/updater
Environment=LOG_FOLDER=/var/log/helios
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/default/helios-updater.env
ExecStart=/var/lib/helios/bin/helios-updater
Restart=always
RestartSec=5
TimeoutStopSec=60
User=root
Group=root
WorkingDirectory=/var/lib/helios
StateDirectory=helios helios/state
LogsDirectory=helios
LimitNOFILE=65536
TasksMax=infinity
OOMScoreAdjust=-200
IOSchedulingClass=best-effort
IOSchedulingPriority=0
CPUAffinity=0 1
Nice=-3

[Install]
WantedBy=network.target
WantedBy=multi-user.target
