[Unit]
Description=Helios Peripherals Service
# lemnosd (the Raze device package's hardware service) owns the sensors, fan and
# status light; helios-peripherals is its client and reconnects when it restarts.
After=network.target orion-node.service lemnosd.service
Wants=network.target orion-node.service lemnosd.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios/peripherals
Environment=LIBAI_CORAL_RUNTIME_ENUMERATION=0
EnvironmentFile=-/etc/default/helios-peripherals.env
ExecStart=/usr/bin/helios-peripherals
# No fan hand-back here: helios-peripherals ends its fan override through lemnosd
# (release) when it stops, a crashed run's override is released on the next start,
# and lemnosd's own ExecStopPost hands every fan back when lemnosd stops.
Restart=always
RestartSec=2
TimeoutStopSec=30
User=root
# Primary group orion: orion-node admits the orion group (ORION_NODE_LOCAL_AUTH in orion-node.env).
Group=orion
# lemnos owns /run/lemnos/lemnosd.sock (mode 0660).
SupplementaryGroups=lemnos
WorkingDirectory=/var/lib/helios
StateDirectory=helios
LogsDirectory=helios
LimitNOFILE=65536
TasksMax=infinity
OOMScoreAdjust=-200

[Install]
WantedBy=multi-user.target
