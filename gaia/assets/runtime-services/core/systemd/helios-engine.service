[Unit]
Description=Helios Engine Service
After=network.target orion-node.service
Wants=network.target orion-node.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# glibc gives each thread its own heap arena; capped, a long run stays flat (Styx soak: 125 MB with the default, 30 MB capped).
Environment=MALLOC_ARENA_MAX=2
Type=simple
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios/panics
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios/engine
ExecStartPre=/usr/bin/install -d -m0755 /var/lib/helios/state
ExecStartPre=/usr/bin/install -d -m0755 /var/lib/helios/plugins/daedalus
Environment=ENGINE_SOCKET=/run/helios/engine.sock
Environment=ENGINE_JOURNAL_PATH=/var/log/helios/engine/engine.log
Environment=HELIOS_ENGINE_CACHE_NODE_REGISTRY=0
Environment=HELIOS_NODE_REGISTRY_SNAPSHOT_PATH=/var/lib/helios/state/node-registry.snapshot.json
Environment=STYX_LIBCAMERA_STOP_WHEN_IDLE=1
Environment=HELIOS_STYX_CAPTURE_QUEUE_DEPTH=1
Environment=HELIOS_STREAM_PREVIEW_ENCODE_INTERVAL_MS=4
Environment=HELIOS_DAEDALUS_DEMAND_DRIVEN=1
Environment=HELIOS_DAEDALUS_PLUGIN_DIRS=/usr/lib/helios/plugins/daedalus:/var/lib/helios/plugins/daedalus
# Per-node timings for the profiler (the engine reads HELIOS_ENGINE_METRICS_LEVEL; timing is the
# cheapest level with per-node durations).
Environment=HELIOS_ENGINE_METRICS_LEVEL=timing
# Daedalus GPU nodes use Vulkan on the CM5 (Daedalus 39ca4b2 dropped its aarch64 Vulkan-only
# default; without this wgpu may pick a GL backend).
Environment=WGPU_BACKEND=vulkan
EnvironmentFile=-/etc/default/helios-engine.env
EnvironmentFile=-/run/helios/robot.env
ExecStart=/usr/bin/helios-engine
Restart=always
RestartSec=2
TimeoutStopSec=45
User=root
# Primary group orion: orion-node admits the orion group (ORION_NODE_LOCAL_AUTH in orion-node.env).
Group=orion
WorkingDirectory=/var/lib/helios
# No StateDirectory=helios: /var/lib/helios is helios-data-setup's bind of /data/helios,
# and systemd re-owns a StateDirectory recursively to the unit's user and group,
# which took orion-node's /var/lib/helios/orion away from the orion user. Root
# needs no grant to write there (no ProtectSystem=).
StateDirectory=helios/state
LogsDirectory=helios
LimitNOFILE=65536
TasksMax=infinity
OOMScoreAdjust=-500
IOSchedulingClass=realtime
IOSchedulingPriority=1
CPUAffinity=1 2 3
Nice=-5

[Install]
WantedBy=multi-user.target
