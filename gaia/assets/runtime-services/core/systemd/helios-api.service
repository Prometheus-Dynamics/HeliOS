[Unit]
Description=Helios API Service
After=network.target
Wants=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios/panics
ExecStartPre=/usr/bin/install -d -m0755 /var/log/helios/api
ExecStartPre=/usr/bin/install -d -m0755 /var/lib/helios/state
ExecStartPre=/usr/bin/install -d -m0755 /var/lib/helios/plugins/daedalus
Environment=RUST_LOG=info
Environment=HELIOS_API_BIND=0.0.0.0:5800
# Two tokio workers and two glibc arenas: -0.6 MB (engine) / -0.45 MB (api) PSS on the CM5,
# no measured cost (the frame path runs on its own threads). Overridable in the env file.
Environment=TOKIO_WORKER_THREADS=2 MALLOC_ARENA_MAX=2
EnvironmentFile=-/etc/default/helios-api.env
EnvironmentFile=-/run/helios/robot.env
ExecStart=/usr/bin/helios-api
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1
RestartSteps=4
RestartMaxDelaySec=8
TimeoutStopSec=10
User=root
Group=root
WorkingDirectory=/var/lib/helios
# No StateDirectory=helios: /var/lib/helios is helios-data-setup's bind of /data/helios,
# and systemd re-owns a StateDirectory recursively to the unit's user and group,
# which took orion-node's /var/lib/helios/orion away from the orion user. Root
# needs no grant to write there (no ProtectSystem=).
LogsDirectory=helios
LimitNOFILE=65536
TasksMax=infinity
OOMScoreAdjust=-300

[Install]
WantedBy=multi-user.target
