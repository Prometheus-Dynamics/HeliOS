[Unit]
Description=Helios OS self-check and safe repair
Documentation=man:systemd.service(5)
After=systemd-remount-fs.service helios-provision.target local-fs.target var-log-journal.mount
Wants=helios-provision.target
Before=helios-api.service helios-engine.service helios-updater.service helios-peripherals.service sshd.service
OnFailure=helios-diagnostics@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/helios-os-self-check.sh
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TimeoutStartSec=45
StandardOutput=journal+console
StandardError=journal+console
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
