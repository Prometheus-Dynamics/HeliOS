[Unit]
Description=Publish the HeliOS UI address for Atlas (manage_url)
Documentation=file:/usr/lib/helios/manage-url
DefaultDependencies=no
After=local-fs.target pd-device-hostname.service
Before=pd-device-identity.service sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/helios/manage-url

[Install]
WantedBy=sysinit.target
